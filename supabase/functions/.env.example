# Edge Function secrets. Set them in Supabase (Edge Functions, then Secrets)
# or with `supabase secrets set --env-file supabase/functions/.env`.
# Never commit the real file.

# Public address of the website (no trailing slash). Used for Stripe return links.
SITE_URL=https://miker888.github.io/aloha-footcare-platform

# Browser origins allowed to call the functions, comma-separated.
# Defaults to the origin of SITE_URL. Add http://localhost:3000 for local testing.
ALLOWED_ORIGINS=https://miker888.github.io

# Until Stripe is connected: record payments as "demo" without charging a card.
# Ignored as soon as STRIPE_SECRET_KEY is set. Never use on the live project.
PAYMENTS_MODE=demo

# Stripe (Canadian account). Use test keys (sk_test_...) first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
