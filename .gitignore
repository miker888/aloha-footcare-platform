# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.production is committed on purpose: it only holds
# browser-safe public values (Supabase URL and publishable key).
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local env
.env.local
.env*.local

# Edge Function secrets
supabase/functions/.env
supabase/.temp/
supabase/.branches/
