# Copy to .env.local for local development.
#
# Both Supabase values are public by design: they ship to the browser. Row
# Level Security in the database is what keeps client records private.
# Never put a secret key, service-role key or Stripe key in any NEXT_PUBLIC_
# variable or in this repo.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set by the GitHub Pages workflow. Leave empty locally or on a custom domain.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
